# Kalam API configuration. Copy to `.env` and adjust. Never commit `.env`.

NODE_ENV=development
PORT=4100
# Only the synent_courses database is used.
MONGODB_URI=mongodb://127.0.0.1:27017/synent_courses
# Origin allowed by CORS (the Vite client), also used to build links in emails.
CLIENT_URL=http://localhost:5175

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Payments: `mock` (local test payments, refused when NODE_ENV=production) or `razorpay`.
PAYMENT_PROVIDER=mock
# Razorpay test mode keys (Dashboard > Account & Settings > API Keys, with Test Mode on).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: secret of the webhook pointing at /api/v1/payments/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Secret used to sign simulated payments with the mock provider.
MOCK_PAYMENT_SECRET=change-me-local-mock-secret

# Email: `outbox` writes emails to server/.mail-outbox/ (development) or `smtp`.
MAIL_TRANSPORT=outbox
MAIL_FROM="Kalam <no-reply@kalam.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Demo accounts created by `npm run seed` (test-only values, change them for any shared deployment).
#   Admin:   admin@kalam.test   / 41cJLCOUh1eS7a
#   Learner: learner@kalam.test / odI3v10NxOps4b
SEED_ADMIN_EMAIL=admin@kalam.test
SEED_ADMIN_PASSWORD=41cJLCOUh1eS7a
SEED_USER_EMAIL=learner@kalam.test
SEED_USER_PASSWORD=odI3v10NxOps4b
